# fragment do Lumia 730 (superman/msm8226) — aplicado sobre o defconfig base do Meridian
# Base: linux-6.6.y · SDD §7 · build1 §E3.1
CONFIG_ARCH_QCOM=y
CONFIG_ARCH_MSM8226=y
CONFIG_SMP=y
CONFIG_ARM_APPENDED_DTB=y
CONFIG_DEVTMPFS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_USB_DWC3=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS_F_ECM=y
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DSI=y
CONFIG_FB=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_IPC=y
